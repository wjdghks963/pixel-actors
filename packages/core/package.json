{
  "name": "@wjdghks963/pixel-actors-core",
  "version": "0.1.1",
  "description": "Core rendering engine for pixel actors",
  "homepage": "https://wjdghks963.github.io/pixel-actors/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjdghks963/pixel-actors.git"
  },
