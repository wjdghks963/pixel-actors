  },
  "dependencies": {
    "@wjdghks963/pixel-actors-core": "0.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.2.0",
    "typescript": "^5.6.3"
  }
}
